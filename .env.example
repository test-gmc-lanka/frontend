# Copy to .env and fill in. Never commit .env.
#
# Local development (npm run dev) needs no variables: Vite proxies /api and /uploads
# to http://localhost:8080 (see vite.config.js).
#
# Docker / staging / production: the container reads these at start-up.

# Base URL of the backend the nginx container forwards /api and /uploads to (no trailing slash)
BACKEND_URL=http://localhost:8080

# Port nginx listens on inside the container (Render sets this automatically)
PORT=80
